generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  pending
  processing
  completed
  failed
}

model User {
  id        String      @id @default(uuid()) @db.Uuid
  email     String      @unique
  name      String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  items     SavedItem[]

  @@map("users")
}

model SavedItem {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid @map("user_id")
  url          String           @db.Text
  title        String           @db.Text
  source       String?
  imageUrl     String?          @db.Text @map("image_url")
  summary      String?          @db.Text
  status       ItemStatus       @default(pending)
  errorMessage String?          @db.Text @map("error_message")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata     ContentMetadata?
  itemTags     ItemTag[]

  @@unique([userId, url])
  @@index([userId], map: "idx_saved_items_user_id")
  @@index([createdAt(sort: Desc)], map: "idx_saved_items_created_at")
  @@index([url], map: "idx_saved_items_url")
  @@map("saved_items")
}

model ContentMetadata {
  id          String    @id @default(uuid()) @db.Uuid
  savedItemId String    @unique @db.Uuid @map("saved_item_id")
  title       String    @db.Text
  description String?   @db.Text
  author      String?
  siteName    String?   @map("site_name")
  imageUrl    String?   @db.Text @map("image_url")
  publishedAt DateTime? @map("published_at")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  savedItem   SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)

  @@map("content_metadata")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique(map: "idx_tags_slug")
  createdAt DateTime  @default(now()) @map("created_at")
  itemTags  ItemTag[]

  @@map("tags")
}

model ItemTag {
  savedItemId String   @db.Uuid @map("saved_item_id")
  tagId       String   @db.Uuid @map("tag_id")
  createdAt   DateTime @default(now()) @map("created_at")
  savedItem   SavedItem @relation(fields: [savedItemId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([savedItemId, tagId])
  @@index([tagId], map: "idx_item_tags_tag_id")
  @@map("item_tags")
}